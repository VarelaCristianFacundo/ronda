# Copy to .env.local and fill in. Only public values belong here: the app never needs the
# Supabase secret/service-role key, so do not add it.

# Supabase project URL (Project Settings -> API) or http://127.0.0.1:54321 for local.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public origin of the app, used for magic-link and invite URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true after configuring the Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false